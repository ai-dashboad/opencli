{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCLI",
  "version": "0.1.5",
  "identifier": "ai.dashboad.opencli",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm --dir ../web dev",
    "beforeBuildCommand": "bash ./stage-sidecar.sh && pnpm --dir ../web build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenCLI",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:* ws://localhost:*; style-src 'self' 'unsafe-inline'"
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ai-dashboad/opencli/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEMTc3RTEyMkZDNUFDNzMKUldSenJNVXZFbjRYcmNaU0xQWUsyaXlTM0FUT0lObEFDSFpiUTlwT0xkS3U0R3YxMTRkenIwVFUK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "externalBin": [
      "bin/opencli"
    ]
  }
}
