# personal files
personal/

# os
.DS_Store
Thumbs.db
# macOS writes a folder icon into a file named `Icon` followed by a carriage
# return. Written as `Icon?` it also matched `icons/` — which is where the
# desktop app's icon lives, so the icon was never committed and every build on
# a fresh checkout failed with "failed to open icon".
Icon[\r]
.Spotlight-V100/

# Unwanted package managers
.yarn/
yarn.lock

# release
package.json-e
session.ts-e
CHANGELOG.ignore.md

# nix related
.direnv
.envrc

# Python bytecode files
__pycache__/
*.pyc


# web build output
web/dist/
# Built only to drive the client from a script against a real server.
web/dist-node/

# desktop build output
desktop/src-tauri/target/
desktop/src-tauri/gen/

# The agent binary is copied in at package time, not tracked.
desktop/src-tauri/bin/

# The site serves the installer from `scripts/`; the copy is made at build time.
website/public/install.sh

# A Bazel checkout, kept out of the repository — except for the one crate the
# Cargo workspace resolves through a path dependency. Without it `cargo
# metadata` cannot parse the workspace at all, so a fresh clone failed before
# it got as far as compiling anything.
vendor/
!vendor/rules_rust/
vendor/rules_rust/*
!vendor/rules_rust/LICENSE.txt
!vendor/rules_rust/rust/
vendor/rules_rust/rust/*
!vendor/rules_rust/rust/runfiles/
