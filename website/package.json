{
  "name": "@ai-dashboad/opencli-website",
  "version": "0.1.0",
  "private": true,
  "description": "opencli.ai \u2014 what OpenCLI is, and where to download it.",
  "type": "module",
  "scripts": {
    "dev": "pnpm run stage && vite",
    "stage": "cp ../scripts/install.sh public/install.sh",
    "build": "pnpm run stage && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler pages deploy dist --project-name=opencli"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.0.0"
  }
}
